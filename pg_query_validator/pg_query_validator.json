{
  "settings": {
    "enabled": true,
    "log_queries": false,
    "log_blocked": true,
    "max_query_length": 1000000,
    "max_statements": 10,
    "block_ddl": false,
    "block_truncate": true,
    "block_copy": true,
    "require_where_clause": true,
    "require_limit": false,
    "max_tables_in_query": 50,
    "blocked_keywords": ["pg_sleep", "pg_read_file", "pg_write_file"],
    "error_messages": {
      "query_too_long": "Query exceeds maximum allowed length",
      "blocked_pattern": "Query matches a blocked pattern",
      "where_required": "WHERE clause is required for UPDATE/DELETE",
      "ddl_blocked": "DDL operations are not allowed",
      "access_denied": "Access denied to this resource",
      "keyword_blocked": "Query contains a blocked keyword"
    }
  },
  "rules": [
    {
      "name": "block_dangerous_functions",
      "rule_type": "regex_block",
      "blocking": true,
      "message": "Dangerous function calls are not allowed",
      "applies_to": ["ALL"],
      "config": {
        "pattern": "(?i)(pg_read_file|pg_write_file|pg_ls_dir|lo_import|lo_export)"
      }
    },
    {
      "name": "limit_query_complexity",
      "rule_type": "complexity_limit",
      "blocking": true,
      "message": "Query is too complex",
      "applies_to": ["SELECT"],
      "config": { "max_joins": 10, "max_subqueries": 5 }
    }
  ],
  "blocked_patterns": [
    {
      "name": "SQL injection - UNION SELECT",
      "pattern": "union\\s+(all\\s+)?select",
      "case_insensitive": true,
      "message": "UNION SELECT is not allowed",
      "applies_to": []
    },
    {
      "name": "Dangerous system functions",
      "pattern": "(?i)(pg_read_file|pg_write_file|lo_import|lo_export)",
      "case_insensitive": true,
      "message": "Access to dangerous system functions is blocked",
      "applies_to": []
    }
  ],
  "access_control": {
    "read_only_tables": ["audit_log", "system_config"],
    "blocked_tables": ["pg_shadow", "pg_authid"],
    "blocked_schemas": ["pg_catalog"],
    "allowed_schemas": []
  },
  "rate_limiting": {
    "max_queries_per_second": 100,
    "max_queries_per_minute": 1000,
    "enabled": false
  }
}